model Category {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  tasks Task[]
}

model Task {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}