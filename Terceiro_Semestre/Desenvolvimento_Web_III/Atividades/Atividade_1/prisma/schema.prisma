// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Person {
  id          Int            @id @default(autoincrement())
  name        String         @db.VarChar(30)
  phones      Number_Phone[]
  person_Cars Person_Car[]
}

model Car {
  id          Int          @id @default(autoincrement())
  model       String       @db.VarChar(20)
  person_Cars Person_Car[]
}

model Number_Phone {
  id     Int    @id @default(autoincrement())
  number String @db.VarChar(11)

  owner     Person @relation(fields: [person_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person_id Int
}

model Person_Car {
  person_Id Int
  car_Id    Int

  person Person @relation(fields: [person_Id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  car    Car    @relation(fields: [car_Id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([person_Id, car_Id])
}
